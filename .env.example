# Somente desenvolvimento local; nenhum segredo real.
ENVIRONMENT=development
DATA_DIR=data
DATABASE_URL=sqlite:///data/ecowatt.sqlite3
EMAIL_PROVIDER=disabled
# SMTP opcional; manter disabled até configurar servidor autorizado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@ecowatt.test
SMTP_TIMEOUT_SECONDS=5
# LOCAL_SECRET reservado; senhas do seed vêm da configuração local.
LOCAL_SECRET=
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=
PUBLIC_ORIGIN=http://127.0.0.1:8000
# Somente loopback HTTP de desenvolvimento; usar true com HTTPS.
COOKIE_SECURE=false
