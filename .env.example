# Somente desenvolvimento local; nenhum segredo real.
ENVIRONMENT=development
DATA_DIR=data
DATABASE_URL=sqlite:///data/ecowatt.sqlite3
EMAIL_PROVIDER=disabled
# Reservados para autenticação e seed, ainda não implementados.
LOCAL_SECRET=
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=
PUBLIC_ORIGIN=http://127.0.0.1:8000
# Somente loopback HTTP de desenvolvimento; usar true com HTTPS.
COOKIE_SECURE=false
